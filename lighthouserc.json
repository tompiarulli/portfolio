{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-prod.mjs",
      "startServerReadyPattern": "Serving production build",
      "url": ["http://localhost:4173/", "http://localhost:4173/404.html"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 1
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2500
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.1
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 200
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/(404\\.html)?$",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://localhost:4173/$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/404\\.html$",
          "assertions": {
            "document-title": [
              "error",
              {
                "minScore": 1
              }
            ],
            "meta-description": [
              "error",
              {
                "minScore": 1
              }
            ],
            "http-status-code": [
              "error",
              {
                "minScore": 1
              }
            ],
            "link-text": [
              "error",
              {
                "minScore": 1
              }
            ],
            "crawlable-anchors": [
              "error",
              {
                "minScore": 1
              }
            ],
            "robots-txt": [
              "error",
              {
                "minScore": 1
              }
            ],
            "hreflang": [
              "error",
              {
                "minScore": 1
              }
            ],
            "canonical": [
              "error",
              {
                "minScore": 1
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
