{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "insertFinalNewline": true,
  "sortImports": false,
  "sortTailwindcss": false,
  "ignorePatterns": ["src/routeTree.gen.ts", "pnpm-lock.yaml"]
}
