{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "react", "jsx-a11y"],
  "env": {
    "browser": true
  },
  "settings": {
    "react": {
      "version": "19.0"
    }
  },
  "rules": {
    "eqeqeq": "warn",
    "no-unused-vars": "warn",
    "no-console": "warn",
    "import/no-cycle": "error",
    "unicorn/no-null": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    ".output",
    ".nitro",
    ".tanstack",
    "node_modules"
  ]
}
